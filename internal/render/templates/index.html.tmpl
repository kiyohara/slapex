<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>#{{.ChannelName}} | {{.WorkspaceName}} | slapex export</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<header class="export-header">
  <h1><span class="channel-hash">#</span>{{.ChannelName}}</h1>
  <dl>
    <dt>Workspace</dt><dd>{{.WorkspaceLine}}</dd>
    <dt>Channel</dt><dd>{{.ChannelLine}}</dd>
    <dt>Exported</dt><dd>{{.ExportedLine}}</dd>
    <dt>Range</dt><dd>{{.RangeLine}}</dd>
  </dl>
</header>
<main class="timeline">
{{- range .Items}}
{{- if .IsDateDivider}}
  <div class="date-divider"><span>{{.Date}}</span></div>
{{- else}}
{{- template "message" .Message}}
{{- end}}
{{- end}}
{{- if .Truncated}}
  <div class="notice">取り扱える件数の上限に達しました。</div>
{{- end}}
</main>
<footer class="export-footer">Generated by slapex</footer>
</body>
</html>
{{- define "message"}}
{{- if .IsSystem}}
  <div class="system-message"><span class="time" title="{{.TimeISO}}">{{.TimeLabel}}</span><span class="system-body">{{.Body}}</span></div>
{{- else}}
  <div class="message">
    <div class="avatar">{{if .AvatarPath}}<img src="{{.AvatarPath}}" alt="">{{else}}<span class="avatar-fallback">{{.AvatarInitial}}</span>{{end}}</div>
    <div class="message-main">
      <div class="message-head">
        <span class="author">{{.Author}}</span>
        <span class="time" title="{{.TimeISO}}">{{.TimeLabel}}</span>
      </div>
      {{- if .Body}}
      <div class="message-body{{if .Italic}} me-message{{end}}">{{.Body}}{{if .Edited}} <span class="edited">(edited)</span>{{end}}</div>
      {{- end}}
      {{- range .Images}}
      <div class="image-block">
        {{- if .OriginalPath}}
        <a href="{{.OriginalPath}}"><img class="upload-thumb" src="{{.ThumbPath}}" alt="{{.Name}}"></a>
        {{- else if .ThumbPath}}
        <img class="upload-thumb" src="{{.ThumbPath}}" alt="{{.Name}}">
        {{- end}}
        {{- if .Note}}<div class="asset-note">{{.Note}}</div>{{end}}
      </div>
      {{- end}}
      {{- range .FilesList}}
      <div class="file-block">
        {{- if .Path}}
        <a class="file-link" href="{{.Path}}">📄 {{.Name}}</a>
        {{- else}}
        <span class="file-link unavailable">📄 {{.Name}}</span>
        {{- end}}
        {{- if .Note}}<div class="asset-note">{{.Note}}</div>{{end}}
      </div>
      {{- end}}
      {{- range .Unfurls}}
      <div class="unfurl">
        {{- if or .Service .ServiceIconPath}}<div class="unfurl-service">{{if .ServiceIconPath}}<img class="unfurl-service-icon" src="{{.ServiceIconPath}}" alt="">{{end}}{{.Service}}</div>{{end}}
        {{- if .Title}}<div class="unfurl-title">{{if .TitleHref}}<a href="{{.TitleHref}}">{{.Title}}</a>{{else}}{{.Title}}{{end}}</div>{{end}}
        {{- if .Text}}<div class="unfurl-text">{{.Text}}</div>{{end}}
        {{- if .ImagePath}}<img class="unfurl-image" src="{{.ImagePath}}" alt="">{{end}}
      </div>
      {{- end}}
      {{- if and .Edited (not .Body)}}
      <div class="edited edited-fallback">(edited)</div>
      {{- end}}
      {{- if .Reactions}}
      <div class="reactions">
        {{- range .Reactions}}
        <span class="reaction"><span class="reaction-emoji">{{.Emoji}}</span><span class="reaction-count">{{.Count}}</span></span>
        {{- end}}
      </div>
      {{- end}}
    </div>
  </div>
  {{- if .Replies}}
  <div class="thread-group">
    <div class="thread-label"><span class="thread-label-icon" aria-hidden="true">↪</span><span>Thread ({{len .Replies}}{{if .RepliesTruncated}}+{{end}} message{{if or .RepliesTruncated (ne (len .Replies) 1)}}s{{end}})</span></div>
    <div class="thread">
      {{- range .Replies}}
      {{- template "message" .}}
      {{- end}}
      {{- if .RepliesTruncated}}<div class="notice">取り扱える件数の上限に達しました。</div>{{end}}
    </div>
  </div>
  {{- end}}
{{- end}}
{{- end}}
