# github-op-integrated MCP server 用 env file のテンプレート。
# このファイルを `github.env` にコピーし、placeholder を自分の値に置き換える。
# `github.env` は gitignore 済みで、commit してはならない。

# GitHub Personal Access Token の 1Password secret reference。
# <VAULT>, <ITEM>, <FIELD> を自分の 1Password vault / item / field に置き換える。
GITHUB_PERSONAL_ACCESS_TOKEN=op://<VAULT>/<ITEM>/<FIELD>

# この server で有効化する MCP tool の allowlist。
# 初期 allowlist は利用頻度の高い collaboration write 操作
# (PR / issue / レビューコメントの作成・更新・返信) をカバーする。
# 追加・変更は guideline でレビュー済みの場合のみ行う。
GITHUB_TOOLS=list_pull_requests,search_pull_requests,pull_request_read,create_pull_request,update_pull_request,issue_read,list_issues,search_issues,issue_write,add_issue_comment,add_reply_to_pull_request_comment

# 任意: read-only モードを有効化する。設定すると、GITHUB_TOOLS に含まれていても
# write 系 tool は無効化される。安全な read-only profile 用。
# GITHUB_READ_ONLY=1

# 任意: 個別 allowlist の代わりに広めの toolset を使う。
# 通常は GITHUB_TOOLS による絞り込みを優先し、CI / Actions 調査など
# 明確な必要性がある場合のみ GITHUB_TOOLSETS を使う。
# GITHUB_TOOLSETS=default

# 任意: GitHub Enterprise host。github.com の場合は未設定で良い。
# GITHUB_HOST=github.example.com
